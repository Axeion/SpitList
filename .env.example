# Postgres. Self-hosted (docker compose) or a Neon connection string.
DATABASE_URL=postgres://spitplate:spitplate@localhost:5432/spitplate

# Port the Astro node server listens on behind Caddy.
PORT=4321

# n8n webhook that receives new submissions for the moderation queue.
# Left blank in development — the submission flow no-ops the notification.
N8N_SUBMISSION_WEBHOOK_URL=

# Shared bearer token for the moderation callback that n8n posts to
# (POST /api/submissions/:id). If unset, that route refuses every request.
ADMIN_API_TOKEN=
