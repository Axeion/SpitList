# ---------------------------------------------------------------------------
# LOCAL DEVELOPMENT values. Do not paste this file into Railway.
#
# On Railway, `localhost` is the app container itself — not your Postgres
# service — so the localhost URL below will fail the pre-deploy migration and
# take the whole deploy down with it. See README "Railway" for what to set
# there; the short version is:
#
#   DATABASE_URL      = ${{Postgres.DATABASE_URL}}   <- reference variable
#   ADMIN_API_TOKEN   = <a generated secret>
#   GOOGLE_CLIENT_ID     / GOOGLE_CLIENT_SECRET
#   ADMIN_ALLOWED_EMAILS = you@example.com
#   PUBLIC_SITE_URL   = https://spitplate.com
#   PORT              = do not set; Railway injects it
# ---------------------------------------------------------------------------

# Postgres. Local instance, or `docker compose up -d db`.
DATABASE_URL=postgres://spitplate:spitplate@localhost:5432/spitplate

# Port the Astro node server listens on. Local only — on Railway this is
# injected and setting it yourself can break routing.
PORT=4321

# n8n webhook that receives new submissions for the moderation queue.
# Blank in development: the submission still files, the notification no-ops.
N8N_SUBMISSION_WEBHOOK_URL=

# Public base URL, used for the links inside outbound notifications. Set this
# in production: behind a proxy the request origin can resolve to the internal
# host, which would put an unreachable link in front of a moderator.
PUBLIC_SITE_URL=

# Shared bearer token for the moderation callback n8n posts to
# (POST /api/submissions/:id). If unset, that route refuses every request.
# Generate with: openssl rand -hex 32
ADMIN_API_TOKEN=

# Google sign-in for the moderation queue at /admin/submissions.
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# (type: Web application) and add this exact authorised redirect URI:
#
#     ${PUBLIC_SITE_URL}/admin/auth/callback
#
# PUBLIC_SITE_URL above must be set for sign-in to work at all — it is what the
# redirect URI is built from.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated list of addresses allowed into the moderation queue.
# An empty list admits nobody. Removing an address ends any session it holds.
ADMIN_ALLOWED_EMAILS=
