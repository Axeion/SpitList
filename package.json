  "dependencies": {
    "@astrojs/node": "^11.1.1",
    "astro": "^7.2.1",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.2.0",
    "typescript": "^5.9.3"
  }
}
