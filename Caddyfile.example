# Native Caddy on the VPS, in front of the app container.
# Copy the relevant block into /etc/caddy/Caddyfile.

spitplate.com, www.spitplate.com {
	encode zstd gzip

	# Astro fingerprints everything under /_astro/, so it is safe to cache hard.
	@immutable path /_astro/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Registry pages are rendered per request and reflect live counts.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy 127.0.0.1:4321

	log {
		output file /var/log/caddy/spitplate.log
		format json
	}
}
