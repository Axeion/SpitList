---
import Base from '../../layouts/Base.astro';
import { CLUBS } from '../../data/clubs';
import { getClubTallies } from '../../lib/admin';
import { getTotals } from '../../lib/registry';
import { formatInt, SITE } from '../../lib/site';

/**
 * Written for club secretaries deciding whether to point members at us, or hand
 * over a roster. The commitments on this page are the ones the code actually
 * enforces — every one of them is testable, which is the only reason to make
 * them in writing.
 */
const [tallies, totals] = await Promise.all([getClubTallies(), getTotals()]);
const byClub = new Map(tallies.map((t) => [t.slug, t]));
---

<Base
  title="For clubs — Spitplate"
  description="What Spitplate does with a club roster, what it never does, and how to give your members a link that credits the club."
>
  <section class="pitch-head">
    <div class="wrap">
      <span class="section-tag">For club secretaries</span>
      <h1>Your members' cars, logged once.</h1>
      <p>
        Spitplate is an independent register of surviving Spitfires by commission and
        VIN number. It is free, it has no advertising, and it does not sell anything.
        This page is the honest version of what we would do with your roster — and
        what we would not.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap two-col">
      <div>
        <h2>What we would do with a roster</h2>
        <ul class="do">
          <li>
            <b>Put it through review, not straight into the register.</b> An imported
            row becomes a proposal a human approves, exactly like a submission from an
            owner.
          </li>
          <li>
            <b>Record where it came from.</b> Every imported entry carries your club as
            its source, permanently and visibly to us.
          </li>
          <li>
            <b>Add to entries rather than overwrite them.</b> If a car is already
            listed, a roster row updates only the fields it actually contains. A
            three-column roster cannot flatten a rich entry.
          </li>
          <li>
            <b>Undo it on request.</b> Imports are batched and reversible. If you
            change your mind, one command removes what your batch added.
          </li>
        </ul>
      </div>

      <div>
        <h2>What we would never do</h2>
        <ul class="dont">
          <li>
            <b>Publish a member's name or location.</b> Imported owner details are
            stored unpublished and stay that way — a roster cannot consent on a
            member's behalf. Only the owner can choose to appear.
          </li>
          <li>
            <b>Show anyone an email address.</b> Contact details are visible to
            moderators for asking questions, and appear on no page and in no export.
          </li>
          <li>
            <b>Sell, licence, or hand the data on.</b> Not to advertisers, not to
            parts suppliers, not to other registers.
          </li>
          <li>
            <b>Take your data without asking.</b> Nothing is scraped. If it is here,
            somebody gave it to us or an owner submitted it.
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="wrap">
      <div class="section-head">
        <span class="section-tag">Simplest first step</span>
        <h2>Give your members a link.</h2>
        <p>
          No roster, no data handover, no commitment. Each club has its own link — cars
          submitted through it are credited to the club, so you can see exactly what
          your members contributed.
        </p>
      </div>

      <div class="club-links">
        {
          CLUBS.map((club) => {
            const tally = byClub.get(club.slug);
            return (
              <a class="club-link" href={`/for-clubs/${club.slug}`}>
                <div>
                  <div class="name">{club.name}</div>
                  <div class="meta mono">
                    {club.country}
                    {tally && tally.published > 0
                      ? ` · ${formatInt(tally.published)} car${tally.published === 1 ? '' : 's'} contributed`
                      : ' · get your link'}
                  </div>
                </div>
                <span class="go" aria-hidden="true">→</span>
              </a>
            );
          })
        }
      </div>

      <p class="missing mono">
        Club not listed? Email <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a> and
        we'll add it.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap narrow">
      <h2>Common questions</h2>

      <h3>Does this compete with our own register?</h3>
      <p>
        It shouldn't. Club registers serve members; this one is a public, cross-club
        count of what survives — the number nobody can produce from a single club's
        roster. A car can be in both, and most useful entries will be.
      </p>

      <h3>What if a member wants out?</h3>
      <p>
        The entry comes down on request, no questions and no form. Ask us or have them
        ask us. Since owner details are unpublished by default, in most cases there is
        nothing about the person to remove in the first place.
      </p>

      <h3>Who checks the data?</h3>
      <p>
        A moderator reviews every submission and every correction before it appears.
        Corrections go through the same queue, so a wrong entry can be fixed by anyone
        who knows better without anyone being able to overwrite entries at will.
      </p>

      <h3>What is the registry at today?</h3>
      <p>
        {formatInt(totals.registered)} cars logged against {formatInt(totals.unitsBuilt)}{' '}
        built. It is early, which is exactly why a club roster makes a real difference
        now.
      </p>
    </div>
  </section>
</Base>

<style>
  .pitch-head {
    background: var(--racing-green);
    color: var(--parchment);
    padding: 68px 0 60px;
  }

  .pitch-head .section-tag {
    color: var(--brass-bright);
  }

  .pitch-head h1 {
    font-size: clamp(34px, 5.6vw, 62px);
    line-height: 0.98;
    color: var(--parchment);
    max-width: 820px;
  }

  .pitch-head p {
    font-size: 18px;
    line-height: 1.6;
    color: var(--chrome);
    max-width: 620px;
    margin-top: 20px;
  }

  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 52px;
  }

  @media (max-width: 860px) {
    .two-col {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }

  .two-col h2 {
    font-size: 28px;
    margin-bottom: 18px;
  }

  .do,
  .dont {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .do li,
  .dont li {
    position: relative;
    padding-left: 28px;
    margin-bottom: 18px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .do li::before,
  .dont li::before {
    position: absolute;
    left: 0;
    top: -1px;
    font-family: var(--font-mono);
    font-size: 15px;
  }

  .do li::before {
    content: '✓';
    color: var(--racing-green-3);
  }

  .dont li::before {
    content: '✕';
    color: var(--signal-red);
  }

  .do b,
  .dont b {
    color: var(--ink);
  }

  .club-links {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  @media (max-width: 760px) {
    .club-links {
      grid-template-columns: 1fr;
    }
  }

  .club-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 14px;
    padding: 16px 18px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 3px;
    text-decoration: none;
    color: var(--ink);
  }

  .club-link:hover {
    border-color: var(--brass);
  }

  .club-link .name {
    font-weight: 600;
    font-size: 15.5px;
  }

  .club-link .meta {
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin-top: 4px;
  }

  .go {
    font-family: var(--font-mono);
    color: var(--signal-red);
    flex: none;
  }

  .missing {
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--ink-mute);
    margin-top: 20px;
  }

  .missing a {
    color: var(--signal-red);
  }

  .narrow {
    max-width: 720px;
  }

  .narrow h2 {
    font-size: 30px;
    margin-bottom: 24px;
  }

  .narrow h3 {
    font-family: var(--font-body);
    text-transform: none;
    letter-spacing: 0;
    font-weight: 700;
    font-size: 18px;
    margin: 28px 0 8px;
  }

  .narrow p {
    font-size: 16.5px;
    line-height: 1.7;
    color: var(--ink-soft);
    margin: 0;
  }
</style>
