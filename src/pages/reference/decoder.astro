---
import Base from '../../layouts/Base.astro';
import { decodeNumber } from '../../lib/decode';
import { db } from '../../lib/db';
import { findCarIdByChassis, resolveSerial, type RangeLookup } from '../../lib/registry';

/**
 * Live decoder. Plain GET form — no JavaScript, shareable result URLs.
 *
 * Everything it reports comes from the number's structure or from this
 * project's own reference data. Nothing is inferred from a table we cannot
 * stand behind — and where a range rests on a single club compilation, the page
 * says which one rather than presenting it as settled.
 */
const raw = Astro.url.searchParams.get('number')?.trim() ?? '';
const decoded = raw ? decodeNumber(raw) : null;

let seriesMatches: { label: string; market: string; yearFrom: number | null; yearTo: number | null }[] = [];
let registered: { publicRef: string } | null = null;
let ranges: RangeLookup = { matches: [], hasRangesForPrefix: false };

// Copied so the page can append its own, database-dependent, caveats without
// mutating what decodeNumber returned.
const unknowns: string[] = decoded && decoded.format !== 'unrecognised' ? [...decoded.unknowns] : [];

if (decoded && decoded.format !== 'unrecognised') {
  const seriesPrefix = decoded.format === 'vin' ? 'VIN' : decoded.prefix;

  const [rows, existing, lookup] = await Promise.all([
    db()`
      select s.label, s.market, s.year_from, s.year_to
      from chassis_series s
      where s.prefix = ${seriesPrefix}
      order by s.ordinal
    `,
    findCarIdByChassis(decoded.normalized),
    resolveSerial(seriesPrefix, decoded.serial),
  ]);

  seriesMatches = rows.map((r) => ({
    label: r.label,
    market: r.market,
    yearFrom: r.year_from === null ? null : Number(r.year_from),
    yearTo: r.year_to === null ? null : Number(r.year_to),
  }));
  registered = existing ? { publicRef: existing.publicRef } : null;
  ranges = lookup;

  if (!ranges.hasRangesForPrefix) {
    unknowns.push(
      decoded.format === 'vin'
        ? 'No VIN sequence ranges are on record, so the build sequence cannot place this car within its model run.'
        : `No serial ranges are on record for the prefix "${seriesPrefix}", so the number cannot place this car within its model run.`
    );
  } else if (ranges.matches.every((m) => m.modelYear === null)) {
    unknowns.push(
      'The ranges we hold identify a model, not a model year. Dating a car to the year needs the build record.'
    );
  }
}

/** Ranges are open-ended where the sources give a first number but no last. */
function rangeText(m: { serialFrom: number; serialTo: number | null }): string {
  const from = m.serialFrom.toLocaleString('en-US');
  return m.serialTo === null
    ? `${from} onwards`
    : `${from}–${m.serialTo.toLocaleString('en-US')}`;
}

const MARKET_LABELS: Record<string, string> = {
  worldwide: 'Worldwide',
  'north-america': 'North America',
  'rest-of-world': 'Rest of world',
};
---

<Base
  title="Number decoder — Spitplate"
  description="Decode a Triumph Spitfire commission number or VIN, and check whether it is already in the registry."
>
  <section class="dec-head">
    <div class="wrap">
      <a class="back mono" href="/reference">← Reference</a>
      <span class="section-tag">Decoder</span>
      <h1>Read a chassis number.</h1>
      <p>
        Commission numbers and 1979–81 VINs both work. Spacing and punctuation don't
        matter.
      </p>

      <form class="dec-form" method="get" action="/reference/decoder">
        <label class="visually-hidden" for="number">Chassis or commission number</label>
        <input
          type="text"
          id="number"
          name="number"
          value={raw}
          placeholder="FH 45231 L  ·  TFADW5AT009898"
          autocomplete="off"
          autocapitalize="characters"
          spellcheck="false"
        />
        <button type="submit" class="btn">Decode</button>
      </form>
    </div>
  </section>

  {
    decoded && (
      <section class="section dec-body">
        <div class="wrap">
          {decoded.format === 'unrecognised' ? (
            <div class="card miss">
              <h2>That doesn't look like a Spitfire number.</h2>
              <p>
                Read as <code>{decoded.normalized || '(nothing)'}</code>. A commission
                number is letters then digits, optionally followed by more letters —
                <code>FH45231L</code>. A late VIN is five letters, a digit, two letters,
                then six digits — <code>TFADW5AT009898</code>.
              </p>
              <p>
                If your plate genuinely reads something else, that is worth knowing:
                <a href="/submit"> submit the car</a> and put the number in the notes.
              </p>
            </div>
          ) : (
            <div class="result-grid">
              <div class="card">
                <h2 class="card-title">
                  {decoded.normalized}
                </h2>

                <dl class="facts">
                  {decoded.facts.map((fact) => (
                    <div class="fact">
                      <dt>{fact.label}</dt>
                      <dd class={fact.uncertain ? 'is-uncertain' : ''}>{fact.value}</dd>
                    </div>
                  ))}
                </dl>

                {ranges.matches.length > 0 && (
                  <div class="ranges">
                    <h3>
                      {ranges.matches.length === 1
                        ? 'Serial falls in'
                        : 'Serial falls in more than one recorded range'}
                    </h3>
                    <ul>
                      {ranges.matches.map((m) => (
                        <li class={m.verified ? 'is-verified' : ''}>
                          <div class="range-head">
                            <b>{m.eraName}</b>
                            <span class="mono range-nums">
                              {decoded.format === 'vin' ? 'VIN' : decoded.prefix} {rangeText(m)}
                            </span>
                          </div>
                          {m.modelYear && <p class="range-year">Model year {m.modelYear}</p>}
                          {m.note && <p class="range-note">{m.note}</p>}
                          <p class="range-src">
                            {m.verified ? 'Two sources agree' : 'One source, unconfirmed'} ·{' '}
                            {m.sourceUrl ? (
                              <a href={m.sourceUrl} rel="nofollow noopener">
                                {m.source}
                              </a>
                            ) : (
                              m.source
                            )}
                          </p>
                        </li>
                      ))}
                    </ul>
                    {ranges.matches.length > 1 && (
                      <p class="series-note">
                        The number alone cannot separate these. The build record can.
                      </p>
                    )}
                  </div>
                )}

                {ranges.matches.length === 0 && ranges.hasRangesForPrefix && (
                  <div class="ranges">
                    <h3>Serial falls outside every recorded range</h3>
                    <p class="series-note">
                      We hold ranges for this prefix and{' '}
                      <b class="mono">{decoded.serial.toLocaleString('en-US')}</b> is not inside
                      any of them. That does not mean the number is wrong. Most of our ranges
                      come from a single club compilation, the factory sequences have gaps that
                      were only partly recorded, and a number nobody wrote down is exactly the
                      kind of thing this registry exists to catch.
                    </p>
                    <p class="series-note">
                      If it is on your car's plate, <a href="/submit">submit it</a> — an
                      out-of-range number is worth more to the record than a tidy one.
                    </p>
                  </div>
                )}

                {seriesMatches.length > 0 && (
                  <div class="series">
                    <h3>
                      {seriesMatches.length === 1
                        ? 'This prefix belongs to'
                        : 'This prefix spans more than one series'}
                    </h3>
                    <ul>
                      {seriesMatches.map((s) => (
                        <li>
                          <b>{s.label}</b>
                          <span class="mono">
                            {MARKET_LABELS[s.market] ?? s.market}
                            {s.yearFrom ? ` · ${s.yearFrom}–${s.yearTo ?? ''}` : ''}
                          </span>
                        </li>
                      ))}
                    </ul>
                    {seriesMatches.length > 1 && (
                      <p class="series-note">
                        The prefix alone cannot separate these. Where ranges are on record,
                        the serial does — see above.
                      </p>
                    )}
                  </div>
                )}
              </div>

              <div class="side">
                <div class={`card status ${registered ? 'is-known' : 'is-new'}`}>
                  <h3>In the registry?</h3>
                  {registered ? (
                    <>
                      <p>
                        Yes — this chassis is logged as{' '}
                        <a href={`/registry/${registered.publicRef}`}>{registered.publicRef}</a>.
                      </p>
                      <a class="btn ghost" href={`/submit?chassis=${encodeURIComponent(raw)}`}>
                        File a correction
                      </a>
                    </>
                  ) : (
                    <>
                      <p>Not yet. If this is your car, it can be.</p>
                      <a class="btn" href={`/submit?chassis=${encodeURIComponent(raw)}`}>
                        Add it to the registry
                      </a>
                    </>
                  )}
                </div>

                {unknowns.length > 0 && (
                  <div class="card unknowns">
                    <h3>What this can't tell you</h3>
                    <ul>
                      {unknowns.map((u) => (
                        <li>{u}</li>
                      ))}
                    </ul>
                    <p>
                      For an individual car, a{' '}
                      <a href="/reference/heritage-certificates">Heritage Certificate</a> is
                      the authoritative answer.
                    </p>
                  </div>
                )}
              </div>
            </div>
          )}
        </div>
      </section>
    )
  }
</Base>

<style>
  .dec-head {
    background: var(--racing-green);
    color: var(--parchment);
    padding: 40px 0 52px;
  }

  .back {
    display: inline-block;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--chrome);
    text-decoration: none;
    margin-bottom: 24px;
  }

  .back:hover {
    color: var(--brass-bright);
  }

  .dec-head .section-tag {
    color: var(--brass-bright);
  }

  .dec-head h1 {
    font-size: clamp(32px, 5vw, 54px);
    line-height: 1;
    color: var(--parchment);
  }

  .dec-head p {
    font-size: 17px;
    color: var(--chrome);
    max-width: 560px;
    margin-top: 14px;
  }

  .dec-form {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 28px;
    max-width: 620px;
  }

  .dec-form input {
    flex: 1 1 300px;
    min-width: 0;
    font-family: var(--font-mono);
    font-size: 16px;
    letter-spacing: 0.04em;
    padding: 14px 16px;
    border: 1px solid rgba(241, 231, 210, 0.25);
    border-radius: 2px;
    background: rgba(0, 0, 0, 0.25);
    color: var(--parchment);
  }

  .dec-form input::placeholder {
    color: rgba(185, 194, 194, 0.5);
  }

  .dec-form input:focus {
    outline: 2px solid var(--brass);
    outline-offset: -1px;
  }

  .dec-body {
    padding: 44px 0 88px;
  }

  .result-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 24px;
    align-items: start;
  }

  @media (max-width: 860px) {
    .result-grid {
      grid-template-columns: 1fr;
    }
  }

  .card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 26px;
  }

  .card-title {
    font-family: var(--font-mono);
    font-size: 26px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: none;
    margin-bottom: 20px;
  }

  .facts {
    margin: 0;
    border-top: 1px solid var(--line);
  }

  .fact {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 14px;
    padding: 11px 0;
    border-bottom: 1px solid var(--line);
  }

  @media (max-width: 520px) {
    .fact {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }

  .facts dt {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-mute);
    padding-top: 3px;
  }

  .facts dd {
    margin: 0;
    font-size: 16px;
  }

  .facts dd.is-uncertain {
    color: var(--ink-mute);
    font-style: italic;
  }

  .series,
  .ranges {
    margin-top: 24px;
  }

  .ranges ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ranges li {
    padding: 12px 0 12px 14px;
    border-left: 2px solid var(--line);
    margin-bottom: 10px;
  }

  /* Corroborated by two sources. The unverified ones are not hidden or
     apologised for — they just don't get the mark. */
  .ranges li.is-verified {
    border-left-color: var(--racing-green-3, var(--signal-red));
  }

  .range-head {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    align-items: baseline;
  }

  .range-head b {
    font-size: 16px;
  }

  .range-nums {
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--ink-mute);
  }

  .range-year {
    font-size: 14px;
    margin: 4px 0 0;
  }

  .range-note,
  .range-src {
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink-mute);
    margin: 5px 0 0;
  }

  .range-src a {
    color: inherit;
  }

  .series h3,
  .ranges h3,
  .side h3 {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--signal-red);
    font-weight: 500;
    margin-bottom: 12px;
  }

  .series ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .series li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding: 9px 0;
    border-bottom: 1px solid var(--line);
    font-size: 15px;
  }

  .series li span {
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }

  .series-note {
    font-size: 13.5px;
    color: var(--ink-mute);
    margin: 12px 0 0;
  }

  .side {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .status.is-known {
    border-color: var(--racing-green-3);
  }

  .status p,
  .unknowns p {
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--ink-soft);
    margin: 0 0 16px;
  }

  .unknowns ul {
    margin: 0 0 14px;
    padding-left: 18px;
  }

  .unknowns li {
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--ink-soft);
    margin-bottom: 8px;
  }

  .miss h2 {
    font-size: 24px;
    margin-bottom: 12px;
  }

  .miss p {
    font-size: 16px;
    line-height: 1.65;
    color: var(--ink-soft);
    margin: 0 0 12px;
  }

  code {
    font-family: var(--font-mono);
    font-size: 13.5px;
    background: rgba(20, 20, 15, 0.06);
    padding: 2px 6px;
    border-radius: 2px;
  }
</style>
