---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

// No per-request data — build it once.
export const prerender = true;

const pages = (await getCollection('reference')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Base
  title="Reference — Spitplate"
  description="Commission numbers, VINs, heritage certificates and model eras: how to read a Triumph Spitfire's identity."
>
  <section class="ref-head">
    <div class="wrap">
      <span class="section-tag">Reference</span>
      <h1>Decode plates, paint, and parts.</h1>
      <p>
        What we can stand behind, and — just as usefully — what we can't yet. Pages
        that still need sourcing say so rather than reading as authoritative.
      </p>
    </div>
  </section>

  <section class="section ref-body">
    <div class="wrap">
      <a class="tool" href="/reference/decoder">
        <div>
          <span class="tool-tag mono">Tool</span>
          <h2>Number decoder</h2>
          <p>
            Paste a commission number or a 1979–81 VIN. It reads the structure, names
            the series, and tells you whether the car is already registered.
          </p>
        </div>
        <span class="go" aria-hidden="true">→</span>
      </a>

      <div class="ref-list">
        {
          pages.map((page) => (
            <a class="ref-item" href={`/reference/${page.id}`}>
              <div>
                <div class="t">
                  {page.data.title}
                  {page.data.status === 'needs-sourcing' && (
                    <span class="tag mono">Needs sourcing</span>
                  )}
                </div>
                <div class="d">{page.data.summary}</div>
              </div>
              <span class="go" aria-hidden="true">→</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .ref-head {
    background: var(--racing-green);
    color: var(--parchment);
    padding: 64px 0 56px;
  }

  .ref-head .section-tag {
    color: var(--brass-bright);
  }

  .ref-head h1 {
    font-size: clamp(32px, 5vw, 56px);
    line-height: 1;
    color: var(--parchment);
  }

  .ref-head p {
    font-size: 17px;
    line-height: 1.6;
    color: var(--chrome);
    max-width: 600px;
    margin-top: 18px;
  }

  .ref-body {
    padding: 44px 0 88px;
  }

  .tool {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding: 28px;
    margin-bottom: 28px;
    border: 1px solid var(--brass);
    border-radius: 4px;
    background: var(--card);
    text-decoration: none;
    color: var(--ink);
    transition: background 0.15s ease;
  }

  .tool:hover {
    background: #fffdf7;
  }

  .tool-tag {
    font-size: 9px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--signal-red);
  }

  .tool h2 {
    font-size: 30px;
    margin: 8px 0 8px;
  }

  .tool p {
    margin: 0;
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 560px;
  }

  .ref-list {
    display: grid;
    gap: 14px;
  }

  .ref-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 14px;
    padding: 20px 22px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 3px;
    text-decoration: none;
    color: var(--ink);
  }

  .ref-item:hover {
    border-color: var(--brass);
  }

  .ref-item .t {
    font-weight: 600;
    font-size: 17px;
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .ref-item .d {
    font-size: 14.5px;
    color: var(--ink-mute);
    margin-top: 5px;
  }

  .tag {
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--signal-red);
    border: 1px solid currentColor;
    border-radius: 2px;
    padding: 2px 6px;
  }

  .go {
    font-family: var(--font-mono);
    font-size: 17px;
    color: var(--signal-red);
    flex: none;
  }
</style>
