---
import { RESOURCES } from '../data/clubs';
---

<section class="section section-alt" id="resources">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="section-tag">Reference</span>
      <h2>Decode plates, paint, and parts.</h2>
      <p>Reference pages are written as markdown and land alongside the registry release.</p>
    </div>

    <div class="res-list reveal">
      {
        RESOURCES.map((res) =>
          res.ready ? (
            <a class="res-item" href={res.href}>
              <div>
                <div class="t">{res.title}</div>
                <div class="d mono">{res.detail}</div>
              </div>
              <span class="go" aria-hidden="true">
                →
              </span>
            </a>
          ) : (
            <div class="res-item is-pending">
              <div>
                <div class="t">{res.title}</div>
                <div class="d mono">{res.detail}</div>
              </div>
              <span class="go pending mono">Soon</span>
            </div>
          )
        )
      }
    </div>
  </div>
</section>

<style>
  .res-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }

  @media (max-width: 700px) {
    .res-list {
      grid-template-columns: 1fr;
    }
  }

  .res-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 14px;
    padding: 18px 20px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 3px;
    text-decoration: none;
    color: var(--ink);
  }

  a.res-item:hover {
    border-color: var(--brass);
  }

  .res-item.is-pending {
    opacity: 0.62;
  }

  .res-item .t {
    font-weight: 600;
    font-size: 15.5px;
  }

  .res-item .d {
    font-size: 11px;
    color: var(--ink-mute);
    margin-top: 4px;
  }

  .res-item .go {
    font-family: var(--font-mono);
    font-size: 16px;
    color: var(--signal-red);
  }

  .res-item .go.pending {
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
</style>
