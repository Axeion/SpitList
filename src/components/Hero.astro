---
import Odometer from './Odometer.astro';
import { formatInt, formatShare } from '../lib/site';
import type { RegistryTotals } from '../lib/registry';

interface Props {
  totals: RegistryTotals;
}

const { totals } = Astro.props;
---

<section class="hero texture" id="top">
  <div class="wrap">
    <span class="eyebrow">Independent · Owner-contributed · Open to corrections</span>
    <h1>Every surviving<br /><em>Spitfire,</em> logged<br />by chassis number.</h1>
    <p class="hero-sub">
      A registry of Triumph Spitfires tracked by commission and VIN number — model by
      model, club by club. Built from what owners send in, and corrected by the people
      who know the cars best.
    </p>

    <div class="plate">
      <div class="plate-label">Registry Tag · {totals.registered > 0 ? 'Live count' : 'Awaiting first entry'}</div>
      <div class="odometer-row">
        <Odometer value={totals.registered} label="Spitfires currently registered" />

        <div class="plate-stats">
          <div class="plate-stat">
            <b class="mono">{formatInt(totals.unitsBuilt)}</b>
            <span>Total built, all models</span>
          </div>
          <div class="plate-stat">
            <b class="mono">{formatShare(totals.sharePct)}</b>
            <span>Of production documented</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background: radial-gradient(90% 120% at 50% -20%, var(--racing-green-3), var(--racing-green) 60%);
    color: var(--parchment);
    padding: 76px 0 60px;
    position: relative;
    overflow: hidden;
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      115deg,
      rgba(255, 255, 255, 0.02) 0 2px,
      transparent 2px 6px
    );
    pointer-events: none;
  }

  .hero .wrap {
    position: relative;
    z-index: 1;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--brass-bright);
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 22px;
  }

  .eyebrow::before {
    content: '';
    width: 26px;
    height: 1px;
    background: var(--brass-bright);
    display: inline-block;
    flex: none;
  }

  .hero h1 {
    font-size: clamp(40px, 7vw, 84px);
    line-height: 0.94;
    color: var(--parchment);
    max-width: 900px;
  }

  .hero h1 em {
    font-style: normal;
    color: var(--brass-bright);
  }

  .hero-sub {
    font-size: 18px;
    line-height: 1.6;
    color: var(--chrome);
    max-width: 560px;
    margin-top: 22px;
  }

  /* Chassis plate holding the odometer. */
  .plate {
    margin-top: 48px;
    background: linear-gradient(180deg, #d9d2c1, #c3baa4);
    border: 1px solid rgba(0, 0, 0, 0.25);
    border-radius: 4px;
    padding: 26px;
    color: var(--ink);
    box-shadow:
      0 30px 60px -25px rgba(0, 0, 0, 0.55),
      inset 0 1px 0 rgba(255, 255, 255, 0.5);
    max-width: 640px;
    position: relative;
  }

  .plate::before,
  .plate::after {
    content: '';
    position: absolute;
    top: 12px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #efe9dc, #8b8271 70%);
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.3);
  }

  .plate::before {
    left: 12px;
  }

  .plate::after {
    right: 12px;
  }

  .plate-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #5b5142;
    margin-bottom: 12px;
  }

  .odometer-row {
    display: flex;
    align-items: flex-end;
    gap: 20px;
    flex-wrap: wrap;
  }

  .plate-stats {
    display: flex;
    gap: 30px;
    margin-left: auto;
    flex-wrap: wrap;
  }

  .plate-stat b {
    display: block;
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 800;
  }

  .plate-stat span {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #5b5142;
  }
</style>
